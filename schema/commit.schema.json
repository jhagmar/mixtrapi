{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jhagmar/mixtrapi/schema/commit.schema.json",
  "title": "Commit",
  "type": "object",
  "additionalProperties": false,
  "required": ["parent", "version", "files"],
  "properties": {
    "parent": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
