{
  "protocol": "mixtrapi/1",
  "session": {
    "channel_path": "/v1/sessions/{session_id}/channel",
    "binary_tips": false
  },
  "auth": {
    "models": [
      {
        "id": "urn:mixtrapi:auth:anonymous-mint",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    ]
  },
  "workspace": {
    "list": true,
    "read": true,
    "create": true,
    "update": true,
    "delete": true,
