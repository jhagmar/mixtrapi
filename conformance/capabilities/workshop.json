{
  "protocol": "mixtrapi/1",
  "session": {
    "channel_path": "/v1/sessions/{session_id}/channel",
    "binary_tips": true
  },
  "auth": {
    "models": [
      {
        "id": "urn:mixtrapi:auth:display-name-grant",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_name"],
          "properties": {
            "display_name": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    ]
  },
  "workspace": {
    "list": true,
    "read": true,
    "create": false,
    "update": true,
    "delete": false,
    "rename": false,
    "mkdir": false,
    "directories": false,
    "binary": false,
    "text_only": true,
    "watch": false,
    "max_files": 1,
    "max_bytes": 1048576,
    "path_policy": [{ "glob": "solve.py", "ops": ["read", "update"] }]
  },
  "limits": {
    "grant_per_hour_per_addr": 10,
    "grants_pending_global": 30,
    "login_per_minute_per_addr": 5,
    "file_bytes": 1048576,
    "file_count": 10000,
    "lsp_dap_bytes": 2097152,
    "log_bytes": 1048576,
    "display_name_chars": 64
  },
  "language_switch": { "languages_path": "/v1/languages" },
  "catalog": { "list_path": "/v1/catalog" },
  "run": { "outcomes": ["pass_fail", "value"] },
  "debug": { "requires_run": true },
  "admin": { "login_path": "/v1/login" }
}
